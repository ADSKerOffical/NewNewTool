player = game.Players.ADSKer380
local tool = Instance.new("Tool", player.Backpack)
tool.Name = "COCONUT SUIT"
tool.ToolTip = "Adds a lot of HP, bounces opponents when touched, but the player becomes slower"

local handle = Instance.new("Part", tool)
handle.Name = "Handle"

local mesh = Instance.new("SpecialMesh", handle)
mesh.MeshId = "rbxassetid://13083001675"
mesh.TextureId = "rbxassetid://13083001520"
mesh.Scale = Vector3.new(1, 1, 1)

tool.Activated:Connect(function()
 local hat, owner = handle:Clone(), tool.Parent
 local player = game.Players:GetPlayerFromCharacter(owner)
 hat.Parent = owner
 tool:Destroy()
 
 if not game:GetService("BadgeService"):UserHasBadgeAsync(player.UserId, 4039313043335590) then
    game:GetService("BadgeService"):AwardBadge(player.UserId, 4039313043335590)
 end
 
 local race = Instance.new("StringValue")
 race.Name = "CocoRace"
 race.Value = "COCO"
 race.Parent = owner
 
 owner.Humanoid.MaxHealth += 1000
 owner.Humanoid.Health += 1000
 hat.Massless = true
 hat.CanCollide = false
 hat.Size = Vector3.new(6, 6, 6)
 
 for _, part in next, owner:GetDescendants() do
    if part:IsA("BasePart") then
       part.CustomPhysicalProperties = PhysicalProperties.new(40, 0.4, 0, 0, 0)
    end
 end
 
 local knockback1 = Instance.new("Sound")
 knockback1.SoundId = "rbxassetid://115931513477019"
 knockback1.Volume = 1
 knockback1.Name = "Basic_Knockback"
 knockback1.Parent = hat
 
 local knockback2 = Instance.new("Sound")
 knockback2.SoundId = "rbxassetid://7214256592"
 knockback2.Volume = 2.5
 knockback2.Name = "Super_Knockback"
 knockback2.Parent = hat
 
 local shoot = Instance.new("Sound")
 shoot.SoundId = "rbxassetid://113244305"
 shoot.Name = "Throw_Coconut"
 shoot.PlaybackSpeed = 0.8
 shoot.Volume = 0.4
 shoot.Parent = hat
 
 local recreate = Instance.new("Sound")
 recreate.Name = "Recreate_Sound"
 recreate.Volume = 1
 recreate.SoundId = "rbxassetid://84312631986360"
 recreate.Parent = hat
 
 local copy = hat:Clone()
 
 hat:GetPropertyChangedSignal("Size"):Connect(function()
    if hat:FindFirstChildOfClass("SpecialMesh") then
       hat:FindFirstChildOfClass("SpecialMesh").Scale = hat.Size / 6
    end
 end)
 
 hat.Touched:Connect(function(part)
    if not part:IsDescendantOf(owner) and (part.Parent:IsA("Model") and part.Parent:FindFirstChildOfClass("Humanoid")) then
       local humanoid = part.Parent:FindFirstChildOfClass("Humanoid")
       if owner.HumanoidRootPart.AssemblyLinearVelocity.Magnitude >= 30 then
          humanoid:TakeDamage(math.clamp(owner.HumanoidRootPart.AssemblyLinearVelocity.Magnitude / 20,  5, 100))
          humanoid.RootPart.AssemblyLinearVelocity = (hat.Position - humanoid.RootPart.Position).Unit * -math.clamp(owner.HumanoidRootPart.AssemblyLinearVelocity.Magnitude / 5,  20, 450)
          
          if owner.HumanoidRootPart.AssemblyLinearVelocity.Magnitude >= 100 then
             humanoid.Sit = true
             knockback1:Play()
          elseif owner.HumanoidRootPart.AssemblyLinearVelocity.Magnitude >= 200 then
             humanoid:ChangeState("FallingDown")
             knockback2:Play()
          end
       end
    end 
 end)
 
 local joint1 = Instance.new("Weld")
 joint1.C0 = CFrame.new(0, -0.65, 0.7)
 joint1.Name = "MainJoint"
 joint1.Part0 = owner.HumanoidRootPart
 joint1.Part1 = hat
 joint1.Parent = hat
 
 hat.ChildRemoved:Connect(function(obj)
    if obj:IsA("Weld") and obj.Name == "MainJoint" then
       local weld = obj:Clone()
       weld.Name = "MainJoint"
       weld.Part0 = owner.HumanoidRootPart
       weld.Part1 = hat
       weld.Parent = hat
    end
 end)
 
 local coco = Instance.new("Tool")
 coco.Name = "Throw the shell"
 coco.RequiresHandle = false
 coco.CanBeDropped = false
 coco.Parent = player.Backpack
 
 coco:GetPropertyChangedSignal("Parent"):Connect(function()
    if coco.Parent ~= player.Backpack and game.Players:GetPlayerFromCharacter(coco.Parent) and not coco.Parent:FindFirstChild("CocoRace") then
       local hum = coco.Parent:WaitForChild("Humanoid")
       local own = coco.Parent
       hum.PlatformStand = true
       hum.Sit = true
       hum:SetStateEnabled("PlatformStanding", true)
       hum:SetStateEnabled("Dead", true)
       
       local sound = Instance.new("Sound")
       sound.SoundId = "rbxassetid://8085401753"
       sound.Volume = 1
       sound.Parent = own.PrimaryPart
       sound:Play()
       game.Debris:AddItem(sound, 7)
       
       sound.Destroying:Connect(function()
          game.Players:GetPlayerFromCharacter(own).Backpack:ClearAllChildren()
          hum.BreakJointsOnDeath = false
          for _, am in next, own:GetDescendants() do
             if am:IsA("JointInstance") then
                am.C0 = am.C0 * CFrame.Angles(math.rad(math.random(-360, 360)), math.rad(math.random(-360, 360)), math.rad(math.random(-360, 360)))
             end
          end
          
          local soundd = Instance.new("Sound")
          soundd.SoundId = "rbxassetid://17321594892"
          soundd.Volume = 1
          soundd.Parent = own.HumanoidRootPart
          soundd:Play()
          
          hum:ChangeState("Dead")
          hum.MaxHealth = 0
          hum.Health = 0
       end)
       
       task.wait()
       coco.Parent = player.Backpack
    end
 end)
 
 local idk = 0
 coco.Activated:Connect(function()
    if tick() - idk >= 4 then
       idk = tick()
       local shell, knc = copy:Clone(), knockback2:Clone()
       shell.CanCollide = true
       shell.Size = Vector3.new(4.5, 4.5, 4.5)
       shell.Shape = "Ball"
       shell:BreakJoints()
       hat.Size = Vector3.zero
       shoot:Play()
       shell.Position = hat.Position + owner.HumanoidRootPart.CFrame.LookVector * 3
       shell.Velocity = owner.HumanoidRootPart.CFrame.LookVector * 300
       shell.Parent = workspace
       game.Debris:AddItem(shell, 10)
       shell:SetNetworkOwner(nil)
       knc.Parent = shell
       
       local hmds = {}
       shell.Touched:Connect(function(part)
          if shell.Velocity.Magnitude >= 10 and not part:IsDescendantOf(owner) and part.Parent:IsA("Model") and part.Parent:FindFirstChildOfClass("Humanoid") and not table.find(hmds, part.Parent) then
             local humanoid = part.Parent:FindFirstChildOfClass("Humanoid")
             table.insert(hmds, humanoid.Parent)
             knc:Play()
             
             humanoid:TakeDamage(75)
             humanoid.RootPart.Velocity = (shell.Position - humanoid.RootPart.Position).Unit * -200
             humanoid.Sit = true
          end
       end)
       
       task.delay(0.75, function()
          game:GetService("TweenService"):Create(hat, TweenInfo.new(3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, 0), {
             Size = Vector3.new(6, 6, 6)
          }):Play()
          recreate:Play()
       end)
    end
 end)
 
 local sound = Instance.new("Sound")
 sound.SoundId = "rbxassetid://457046954"
 sound.Volume = 2
 sound.PlaybackSpeed = 1.1
 sound.TimePosition = 0.3
 sound.Parent = hat
 sound:Play()
 game.Debris:AddItem(sound, 5)
end)
