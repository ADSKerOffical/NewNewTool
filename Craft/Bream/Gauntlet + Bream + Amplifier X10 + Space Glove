local function createExplosion(pos, owner, damage, vel, range, tye)
   local core
   if tye == 1 then
      core = Instance.new("Part")
      core.Size = Vector3.zero
      core.Position = pos
      core.Anchored = true
      core.Parent = workspace
      game.Debris:AddItem(core, 5)
   
      local explosion = Instance.new("Explosion")
      explosion.BlastRadius = 0
      explosion.Position = core.Position
      explosion.Parent = core
   elseif tye == 2 then
      core = Instance.new("Part")
      core.Position = pos
      core.Shape = "Ball"
      core.Anchored = true
      core.Color = Color3.new(1, 0, 0)
      core.Parent = workspace
      game.Debris:AddItem(core, 5)
      
      game:GetService("TweenService"):Create(core, TweenInfo.new(1.25, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out, 0, false, 0), {
         Size = Vector3.new(range, range, range),
         Transparency = 1,
         Color = Color3.new(0, 0, 0)
      }):Play()
   end
   
     local humanoids = {}
  for _, part in next, workspace:GetPartBoundsInRadius(core.Position, range) do
      if part.Parent:IsA("Model") and part.Parent:FindFirstChildOfClass("Humanoid") and not part:IsDescendantOf(owner) then
        if not table.find(humanoids, part.Parent:FindFirstChildOfClass("Humanoid")) then
          table.insert(humanoids, part.Parent:FindFirstChildOfClass("Humanoid"))
        end
      end
    end

   for _, humanoid in next, humanoids do
      humanoid:TakeDamage(damage)
      humanoid.RootPart.Velocity = (core.Position - humanoid.RootPart.Position).Unit * -vel
      if tye == 2 then
        humanoid:ChangeState("FallingDown")
      end
    end
end

