local tool = Instance.new("Tool", game.Players.ADSKer380.Backpack)
tool.Name = "Grenade Launcher"
tool.Grip = CFrame.new(0, -0.7, 0) * CFrame.Angles(0, math.rad(180), 0)

local handle = Instance.new("Part", tool)
handle.Name = "Handle"

local mesh = Instance.new("SpecialMesh", handle)
mesh.MeshId = "rbxassetid://467359017"
mesh.TextureId = "rbxassetid://467359047"
mesh.Scale = Vector3.new(0.03, 0.03, 0.03)

local last = 0
tool.Activated:Connect(function()
   if tick() - last >= 1 then
      last = tick()
      local owner = tool.Parent
      local player = game.Players:GetPlayerFromCharacter(owner)
      
      local grenade = Instance.new("Part")
      grenade.Material = "Concrete"
      grenade.Color = Color3.new(0.1, 0.1, 0.1)
      grenade.Shape = "Ball"
      grenade.Position = handle.Position
      grenade.Velocity = player.MousePosition.Value.LookVector * 200
      grenade.Size = Vector3.new(1.5, 1.5, 1.5)
      grenade.Parent = workspace
      grenade:SetNetworkOwner(nil)
      game.Debris:AddItem(grenade, 5)
      
      local sound = Instance.new("Sound")
      sound.SoundId = "rbxassetid://132746925891911"
      sound.Volume = 1
      sound.Parent = handle
      sound:Play()
      game.Debris:AddItem(sound, 5)
      
      local humanoids = {}
      local enabl = false
for _, part in next, workspace:GetPartBoundsInRadius(handle.Position, 100) do
    if part.Parent:IsA("Model") and part.Parent:FindFirstChildOfClass("Humanoid") and not part:IsDescendantOf(owner) then
      if not table.find(humanoids, part.Parent:FindFirstChildOfClass("Humanoid")) then
        table.insert(humanoids, part.Parent:FindFirstChildOfClass("Humanoid"))
      end
    end
  end

  if #humanoids > 0 then
    enabl = true 
  end
      
      task.delay(enabl == false and 2 or enabl == true and 1, function()
         if grenade then
            local explosion = Instance.new("Part")
       explosion.Anchored = true
       explosion.CanCollide = false
       explosion.CanTouch = false
       explosion.CanQuery = false
       explosion.Color = Color3.new(1, 0.5, 0)
       explosion.Position = grenade.Position
       explosion.Shape = "Ball"
       explosion.Material = "Neon"
       explosion.Parent = workspace
       game.Debris:AddItem(explosion, 5)
       grenade:Destroy()
       
       local sound = Instance.new("Sound")
       sound.SoundId = "rbxassetid://18694762392"
       sound.Volume = 1.25
       sound.PlaybackSpeed = 1
       sound.Parent = explosion
       sound:Play()
       
       local humanoids = {}
for _, part in next, workspace:GetPartBoundsInRadius(explosion.Position, 15) do
    if part.Parent:IsA("Model") and part.Parent:FindFirstChildOfClass("Humanoid") and not part:IsDescendantOf(owner) then
      if not table.find(humanoids, part.Parent:FindFirstChildOfClass("Humanoid")) then
        table.insert(humanoids, part.Parent:FindFirstChildOfClass("Humanoid"))
      end
    end
  end

    for _, humanoid in next, humanoids do
      humanoid:TakeDamage(math.clamp(200 / (explosion.Position - humanoid.RootPart.Position).Magnitude * 4, 5, 80))
      humanoid.RootPart.Velocity = (explosion.Position - humanoid.RootPart.Position).Unit * -math.clamp(300 / (explosion.Position - humanoid.RootPart.Position).Magnitude * 7, 50, 300)
    end
    
    for _, part in next, workspace:GetPartBoundsInRadius(explosion.Position, 15) do
      if part.Anchored == false then
        part.Velocity = (explosion.Position - part.Position).Unit * -100
      end
    end
       
       local partTweenn2 = game:GetService("TweenService"):Create(explosion, TweenInfo.new(0.4, Enum.EasingStyle.Exponential), {
            Size = Vector3.new(20, 20, 20),
            Color = Color3.new(0, 0, 0),
            Transparency = 1
         })
       partTweenn2:Play()
         end 
      end)
   end
end)
